# Public DNS name pointing to this server; ports 80 and 443 must be reachable.
DOMAIN=secentral.example.com

# Generate with: openssl rand -hex 32
SECRET_KEY_BASE=replace-with-a-random-secret
SECENTRAL_SERVER_DATABASE_PASSWORD=replace-with-a-random-password
SECENTRAL_INGESTION_KEY=replace-with-a-random-ingestion-key

ADMIN_USERNAME=admin
# Generate a bcrypt digest using the instructions in docs/quick-start.md.
ADMIN_PASSWORD_DIGEST=replace-with-a-bcrypt-digest
