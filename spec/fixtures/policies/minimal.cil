; Synthetic test policy. Compile with Debian secilc 3.8.1-1:
; secilc -o minimal.policy -f /dev/null minimal.cil
(class file (read write))
(classorder (file))
(sid kernel)
(sidorder (kernel))
(type source_t)
(type target_t)
(type permissive_t)
(typepermissive permissive_t)
(allow source_t target_t (file (read)))
(role system_r)
(roletype system_r source_t)
(roletype system_r target_t)
(roletype system_r permissive_t)
(user system_u)
(userrole system_u system_r)
(sensitivity s0)
(sensitivityorder (s0))
(userlevel system_u (s0))
(userrange system_u ((s0) (s0)))
(sidcontext kernel (system_u system_r source_t ((s0) (s0))))
