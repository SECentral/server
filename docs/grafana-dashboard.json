          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reporting"
            },
            "properties": [
              {
                "id": "color",
