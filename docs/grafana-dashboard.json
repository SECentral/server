      "description": "Recent agent contact, not proof of capture completeness or delivery health.",
      "targets": [
        {
          "refId": "A",
          "expr": "secentral_agent_installations{job=\"secentral\"}",
          "legendFormat": "{{state}}",
          "datasource": {
            "type": "prometheus",
