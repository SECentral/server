ARG RUBY_VERSION=4.0.6
FROM docker.io/library/ruby:${RUBY_VERSION}-slim

WORKDIR /workspace/server

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential ca-certificates curl git libpq-dev libyaml-dev nodejs npm pkg-config postgresql-client setools && \
    rm -rf /var/lib/apt/lists/*

ENV BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_JOBS=4 \
    BUNDLE_RETRY=3

COPY Gemfile Gemfile.lock ./
RUN bundle install

CMD ["bash"]
